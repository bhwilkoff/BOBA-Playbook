			</dict>
			<key>AppIcon-Brawl</key>
			<dict>
				<key>CFBundleIconName</key>
				<string>AppIcon-Brawl</string>
			</dict>
			<key>AppIcon-Glow</key>
			<dict>
				<key>CFBundleIconName</key>
				<string>AppIcon-Glow</string>
			</dict>
			<key>AppIcon-Gum</key>
			<dict>
				<key>CFBundleIconName</key>
				<string>AppIcon-Gum</string>
			</dict>
			<key>AppIcon-Super</key>
			<dict>
				<key>CFBundleIconName</key>
				<string>AppIcon-Super</string>
			</dict>
		</dict>
	</dict>
</dict>
</plist>
