<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>NSCameraUsageDescription</key>
	<string>BOBA Playbook uses your camera to scan and identify trading cards in real time.</string>
	<key>NSPhotoLibraryAddUsageDescription</key>
	<string>BOBA Playbook saves pricing overlay images to your Photos library so you can share them outside the app.</string>
	<key>NSLocationWhenInUseUsageDescription</key>
	<string>BOBA Playbook uses your location to show nearby authorized retailers. Your location is never stored or shared.</string>
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<!-- AirPlay-Video for Personal Showcase.
	     `UIBackgroundModes = [audio]` is REQUIRED for AirPlay-Video
	     sessions to survive when the user switches apps (per user
	     request). Trade-off: this declaration causes iOS to surface
	     a "tap to AirPlay" suggestion in the Dynamic Island at launch
	     whenever an AirPlay receiver is on the network. No public API
	     exists to declare audio background capability without that
	     popup. (`AVInitialRouteSharingPolicy = LongFormVideo` is NOT
	     set — that's an additional, separate trigger we don't need;
	     audio-session policy at runtime is enough for AirPlay-Video
	     to engage on demand.) -->
	<key>UIBackgroundModes</key>
	<array>
		<string>audio</string>
	</array>

	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleTypeRole</key>
			<string>Editor</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>bobaplaybook</string>
			</array>
		</dict>
	</array>
	<!-- canOpenURL allowlist. Each scheme listed here can be probed
	     before opening; without the entry canOpenURL silently
	     returns false. Currently used by the Watch tab's
	     OpenInYouTubeButton to deep-link into the YouTube app when
	     installed (else it falls back to SFSafariViewController). -->
	<key>LSApplicationQueriesSchemes</key>
	<array>
		<string>youtube</string>
	</array>
	<key>CFBundleIcons</key>
	<dict>
		<key>CFBundlePrimaryIcon</key>
		<dict>
			<key>CFBundleIconName</key>
			<string>AppIcon</string>
		</dict>
		<key>CFBundleAlternateIcons</key>
		<dict>
			<key>AppIcon-Ice</key>
			<dict>
				<key>CFBundleIconName</key>
				<string>AppIcon-Ice</string>
			</dict>
			<key>AppIcon-Hex</key>
			<dict>
				<key>CFBundleIconName</key>
				<string>AppIcon-Hex</string>
			</dict>
			<key>AppIcon-Steel</key>
			<dict>
				<key>CFBundleIconName</key>
				<string>AppIcon-Steel</string>
			</dict>
			<key>AppIcon-Brawl</key>
			<dict>
				<key>CFBundleIconName</key>
				<string>AppIcon-Brawl</string>
			</dict>
			<key>AppIcon-Glow</key>
			<dict>
				<key>CFBundleIconName</key>
				<string>AppIcon-Glow</string>
			</dict>
			<key>AppIcon-Gum</key>
			<dict>
				<key>CFBundleIconName</key>
				<string>AppIcon-Gum</string>
			</dict>
			<key>AppIcon-Super</key>
			<dict>
				<key>CFBundleIconName</key>
				<string>AppIcon-Super</string>
			</dict>
		</dict>
	</dict>
</dict>
</plist>
