    "date": "YYYY-MM-DD string OR null for 'TBA'",
    "endDate": "optional YYYY-MM-DD when the event spans days",
    "location": "optional string — venue / city / online",
    "description": "1-3 sentence blurb",
    "formats": "optional [string] — formats being played (tournaments only)",
    "set": "optional string — set being released (releases only)",
    "url": "optional external link",
    "_curated": "bool — if true, refresh_events.py preserves this entry across automated runs"
  },
