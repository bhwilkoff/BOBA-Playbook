<?xml version="1.0" encoding="utf-8"?>
<!-- BOBA Playbook XOXO mark (DECISIONS.md #019).
     Mirrors the iOS app icon (BOBAPlaybook/Assets.xcassets/AppIcon
     .appiconset/icon.png) — same XOXO grid, same brand orange, same
     rounded stroke caps. Sized for Android's adaptive-icon canvas
     (108dp viewport, 72dp safe zone). Strokes are thick enough to
     read at small launcher sizes; the marks fit inside the 66% safe
     zone so launchers can apply pill / circle / squircle crops
     without clipping the artwork. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Top-left: X -->
    <path
        android:strokeColor="@color/boba_orange"
        android:strokeWidth="11"
        android:strokeLineCap="round"
        android:pathData="M22,22 L52,52 M52,22 L22,52" />

    <!-- Top-right: O -->
    <path
        android:strokeColor="@color/boba_orange"
        android:strokeWidth="11"
        android:strokeLineCap="round"
        android:pathData="M71,37 m-15,0 a15,15 0 1,0 30,0 a15,15 0 1,0 -30,0" />

    <!-- Bottom-left: O -->
    <path
        android:strokeColor="@color/boba_orange"
        android:strokeWidth="11"
        android:strokeLineCap="round"
        android:pathData="M37,71 m-15,0 a15,15 0 1,0 30,0 a15,15 0 1,0 -30,0" />

    <!-- Bottom-right: X -->
    <path
        android:strokeColor="@color/boba_orange"
        android:strokeWidth="11"
        android:strokeLineCap="round"
        android:pathData="M56,56 L86,86 M86,56 L56,86" />
</vector>
