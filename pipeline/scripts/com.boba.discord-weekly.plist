<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.boba.discord-weekly</string>

    <!--
      Weekly Discord pull, AUTO-only ship.
      Runs Sunday at 8:00 AM Mountain Time. launchd uses system clock,
      and the user's Mac may be set to Pacific — 8 AM MT = 7 AM PT in
      DST. Setting Hour=8 in plist + relying on user's TZ; if Mac TZ
      is Pacific, this fires at 8 AM PT = 9 AM MT instead. Either way
      it's a sane Sunday morning slot.

      Reload after edits:
        launchctl unload ~/Library/LaunchAgents/com.boba.discord-weekly.plist
        launchctl load   ~/Library/LaunchAgents/com.boba.discord-weekly.plist

      Trigger manually for testing:
        launchctl start com.boba.discord-weekly
    -->

    <key>ProgramArguments</key>
    <array>
        <string>/Users/bhwilkoff/Documents/GitHub/BOBA-Playbook/pipeline/scripts/discord_weekly_cron.sh</string>
    </array>

    <key>StartCalendarInterval</key>
    <dict>
        <key>Weekday</key>
        <integer>0</integer>      <!-- 0 = Sunday -->
        <key>Hour</key>
        <integer>8</integer>
        <key>Minute</key>
        <integer>0</integer>
    </dict>

    <!-- Working directory for the shell script's relative paths -->
    <key>WorkingDirectory</key>
    <string>/Users/bhwilkoff/Documents/GitHub/BOBA-Playbook</string>

    <!-- Stdout/stderr go to the same log the script writes to -->
    <key>StandardOutPath</key>
    <string>/Users/bhwilkoff/Library/Logs/boba-discord-weekly.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/bhwilkoff/Library/Logs/boba-discord-weekly.log</string>

    <!--
      RunAtLoad=false because the script is heavy (multi-GB DCE export
      + 23min cardreckon). User explicitly triggers via launchctl start
      for first run; cron handles subsequent.
    -->
    <key>RunAtLoad</key>
    <false/>
</dict>
</plist>
