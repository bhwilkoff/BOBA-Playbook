<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  com.bobaplaybook.pricing-daily — launchd job for the daily self-
  improving pricing loop. Runs scripts/daily_pricing_refresh.sh once
  per day at 09:00 Mountain Time (15:00 UTC standard / 16:00 UTC DST —
  launchd uses LOCAL time so the wall clock stays at 9am year-round).

  Why 09:00 local: matches Ben's working hours (per memory
  user_timezone), so the Mac is reliably awake + on Wi-Fi. The catalog
  has fresh tracker data from the prior 24 hours of user activity, and
  any failure shows up early enough in the day to fix.

  Install:
    ln -sfn /Users/bhwilkoff/Documents/GitHub/BOBA-Playbook/scripts/com.bobaplaybook.pricing-daily.plist \
            ~/Library/LaunchAgents/com.bobaplaybook.pricing-daily.plist
    launchctl bootstrap gui/$(id -u) ~/Library/LaunchAgents/com.bobaplaybook.pricing-daily.plist
    launchctl enable gui/$(id -u)/com.bobaplaybook.pricing-daily

  Trigger manually (skip the schedule, run now):
    launchctl kickstart gui/$(id -u)/com.bobaplaybook.pricing-daily

  Inspect status:
    launchctl print gui/$(id -u)/com.bobaplaybook.pricing-daily

  Uninstall:
    launchctl bootout gui/$(id -u)/com.bobaplaybook.pricing-daily
    rm ~/Library/LaunchAgents/com.bobaplaybook.pricing-daily.plist

  Logs:
    tail -f ~/Library/Logs/boba-pricing-daily.out.log
    tail -f ~/Library/Logs/boba-pricing-daily.err.log

  Full docs: PRICING_AUTOMATION.md §3 (daily refresh layer) + §7 (setup).
-->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.bobaplaybook.pricing-daily</string>

  <!--
    Use zsh as a login shell so the user's PATH (homebrew, ~/.local/bin)
    + git credentials (macOS Keychain helper) + wrangler OAuth config
    are all loaded the same way as an interactive Terminal session.
  -->
  <key>ProgramArguments</key>
  <array>
    <string>/bin/zsh</string>
    <string>-lc</string>
    <string>cd /Users/bhwilkoff/Documents/GitHub/BOBA-Playbook &amp;&amp; exec scripts/daily_pricing_refresh.sh</string>
  </array>

  <!-- 09:00 local time, every day. -->
  <key>StartCalendarInterval</key>
  <dict>
    <key>Hour</key>
    <integer>9</integer>
    <key>Minute</key>
    <integer>0</integer>
  </dict>

  <!--
    If the Mac is asleep at 09:00, run when it wakes. launchd will fire
    the missed StartCalendarInterval once after wake. (RunAtLoad would
    fire at every login + sleep-wake — too noisy.)
  -->
  <key>RunAtLoad</key>
  <false/>

  <!--
    One-shot per fire — don't keep the script alive between runs.
    The script self-terminates after the loop completes.
  -->
  <key>KeepAlive</key>
  <false/>

  <!--
    Log redirection. macOS rotates logs in ~/Library/Logs automatically.
    Console.app reads from here too if you want a GUI view.
  -->
  <key>StandardOutPath</key>
  <string>/Users/bhwilkoff/Library/Logs/boba-pricing-daily.out.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/bhwilkoff/Library/Logs/boba-pricing-daily.err.log</string>

  <!--
    Working directory — also set by the ProgramArguments cd, this is
    just a defense-in-depth so Python imports + git all resolve.
  -->
  <key>WorkingDirectory</key>
  <string>/Users/bhwilkoff/Documents/GitHub/BOBA-Playbook</string>

  <!--
    Process priority — keep the cron polite so it doesn't fight
    foreground work (it's a 15-25 min job touching the network +
    Python + git, all CPU-light but I/O active).
  -->
  <key>Nice</key>
  <integer>10</integer>

  <!--
    Inherit the user's environment (PATH, HOME, etc.). launchd's
    default environment is minimal; this is the simplest way to give
    the script everything zsh would give an interactive shell.
  -->
  <key>EnvironmentVariables</key>
  <dict>
    <key>HOME</key>
    <string>/Users/bhwilkoff</string>
    <key>LANG</key>
    <string>en_US.UTF-8</string>
  </dict>
</dict>
</plist>
